@page
@model StudentRegistrationSystem.Pages.AuditLogs.IndexModel
@{
    ViewData["Title"] = "Audit Logs";
}

<div class="page-header-section">
    <div class="container">
        <h1>Audit Logs</h1>
        <p class="lead">Recent create, edit, and delete actions recorded by the system.</p>
    </div>
</div>

<div class="container py-5">
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-journal-text me-2"></i>Recent Activity</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Action</th>
                            <th>Entity</th>
                            <th>By</th>
                            <th>Role</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.Logs)
                        {
                            <tr>
                                <td>@log.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                                <td><span class="badge bg-primary-subtle text-primary">@log.Action</span></td>
                                <td>@log.EntityName @log.EntityId</td>
                                <td>@log.PerformedBy</td>
                                <td>@log.PerformedByRole</td>
                                <td>@log.Details</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>